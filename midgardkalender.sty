% --------------------------------------------------------------------------
% Zeitspannen
% --------------------------------------------------------------------------
% Syntax:
%   \zeitspanne[<TikZ-Stil>]{<Anfang>}{<Label Anfang>}{<Ende>}{<Label Ende>}
% Spaeter gezeichnete \kalendereintrag-Knoten koennen die gefaerbten Felder ueberschreiben.
\NewDocumentCommand{\zeitspanne}{O{fill=orange!18} m m m m}{%
  \begingroup
  \ifx\mk@type\mk@type@standard
    \mk@standarddateindex{#2}\mk@spanstart
    \mk@standarddateindex{#4}\mk@spanend
    \def\mk@spantotal{364}%
    \ifnum\mk@spanend<\mk@spanstart\relax
      \pgfmathtruncatemacro{\mk@spanend}{\mk@spanend+\mk@spantotal}%
    \fi
    \foreach \mk@spanindex in {\mk@spanstart,...,\mk@spanend}{%
      \pgfmathtruncatemacro{\mk@wrappedindex}{mod(\mk@spanindex-1,\mk@spantotal)+1}%
      \mk@standardindexdate{\mk@wrappedindex}%
      \def\mk@spanlabel{}%
      \ifnum\mk@spanindex=\mk@spanstart\relax\def\mk@spanlabel{#3}\fi
      \ifnum\mk@spanindex=\mk@spanend\relax
        \ifnum\mk@spanend=\mk@spanstart\relax\else\def\mk@spanlabel{#5}\fi
      \fi
      \node[tag,#1] at (\mk@spancoord) {\dayfont\mk@spanlabel};%
    }%
  \else
    \mk@nahuatlandateindex{#2}\mk@spanstart
    \mk@nahuatlandateindex{#4}\mk@spanend
    \def\mk@spantotal{364}%
    \ifnum\mk@spanend<\mk@spanstart\relax
      \pgfmathtruncatemacro{\mk@spanend}{\mk@spanend+\mk@spantotal}%
    \fi
    \foreach \mk@spanindex in {\mk@spanstart,...,\mk@spanend}{%
      \pgfmathtruncatemacro{\mk@wrappedindex}{mod(\mk@spanindex-1,\mk@spantotal)+1}%
      \mk@nahuatlanindexdate{\mk@wrappedindex}%
      \def\mk@spanlabel{}%
      \ifnum\mk@spanindex=\mk@spanstart\relax\def\mk@spanlabel{#3}\fi
      \ifnum\mk@spanindex=\mk@spanend\relax
        \ifnum\mk@spanend=\mk@spanstart\relax\else\def\mk@spanlabel{#5}\fi
      \fi
      \node[tag,#1] at (\mk@spancoord) {\dayfont\mk@spanlabel};%
    }%
  \fi
  \endgroup}

\def\mk@standarddateindex#1#2{\expandafter\mk@standarddateindex@aux#1\@nil#2}
\def\mk@standarddateindex@aux#1-#2-#3\@nil#4{%
  \pgfmathtruncatemacro{#4}{(#3-1)*28+(#2-1)*14+#1}}
\def\mk@standardindexdate#1{%
  \pgfmathtruncatemacro{\mk@spanmonth}{floor((#1-1)/28)+1}%
  \pgfmathtruncatemacro{\mk@spanrest}{mod(#1-1,28)}%
  \pgfmathtruncatemacro{\mk@spanpart}{floor(\mk@spanrest/14)+1}%
  \pgfmathtruncatemacro{\mk@spanday}{mod(\mk@spanrest,14)+1}%
  \edef\mk@spancoord{\mk@spanday-\mk@spanpart-\mk@spanmonth}}

\def\mk@nahuatlandateindex#1#2{%
  \IfBeginWith{#1}{hollow-after-}{%
    \StrBehind{#1}{hollow-after-}[\mk@afterq]%
    \ifcase\mk@afterq\relax
    \or\or\def#2{41}%  after 2
    \or\or\or\or\or\or\def#2{162}% after 8
    \or\or\or\or\or\or\or\def#2{303}% after 15
    \or\or\or\def#2{364}% after 18
    \else\PackageError{midgardkalender-v2-2}{Unbekannter Hohler Tag `#1'}{}\def#2{1}\fi
  }{\expandafter\mk@nahuatlandateindex@aux#1\@nil#2}}
\def\mk@nahuatlandateindex@aux#1-#2\@nil#3{%
  \pgfmathtruncatemacro{#3}{(#2-1)*20+#1+(#2>2)+(#2>8)+(#2>15)}}
\def\mk@nahuatlanindexdate#1{%
  \ifnum#1=41\relax\def\mk@spancoord{hollow-after-2}%
  \else\ifnum#1=162\relax\def\mk@spancoord{hollow-after-8}%
  \else\ifnum#1=303\relax\def\mk@spancoord{hollow-after-15}%
  \else\ifnum#1=364\relax\def\mk@spancoord{hollow-after-18}%
  \else
    \pgfmathtruncatemacro{\mk@regularindex}{#1-(#1>41)-(#1>162)-(#1>303)}%
    \pgfmathtruncatemacro{\mk@spanq}{floor((\mk@regularindex-1)/20)+1}%
    \pgfmathtruncatemacro{\mk@spanday}{mod(\mk@regularindex-1,20)+1}%
    \edef\mk@spancoord{\mk@spanday-\mk@spanq}%
  \fi\fi\fi\fi}

