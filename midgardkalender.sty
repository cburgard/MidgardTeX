% Einzelereignis registrieren:
%   \mk@event{<Region>}{<ID>}{<Datum>}{<Label>}
\newcommand{\mk@event}[4]{%
  \expandafter\gdef\csname midgardkalender@#1@#2@type\endcsname{event}%
  \expandafter\gdef\csname midgardkalender@#1@#2@date\endcsname{#3}%
  \expandafter\gdef\csname midgardkalender@#1@#2@label\endcsname{#4}}

% Zeitspanne registrieren:
%   \mk@range{<Region>}{<ID>}{<Anfang>}{<Anfangslabel>}{<Ende>}{<Endlabel>}
\newcommand{\mk@range}[6]{%
  \expandafter\gdef\csname midgardkalender@#1@#2@type\endcsname{range}%
  \expandafter\gdef\csname midgardkalender@#1@#2@start\endcsname{#3}%
  \expandafter\gdef\csname midgardkalender@#1@#2@startlabel\endcsname{#4}%
  \expandafter\gdef\csname midgardkalender@#1@#2@end\endcsname{#5}%
  \expandafter\gdef\csname midgardkalender@#1@#2@endlabel\endcsname{#6}}

% Rueckwaertskompatible Datumsanpassung fuer Einzelereignisse.
\newcommand{\setzedatum}[3]{%
  \expandafter\gdef\csname midgardkalender@#1@#2@date\endcsname{#3}}

