\def\mk@showholidays{%
  \edef\mk@ids{\csname mk@annotationids@\mk@region\endcsname}%
  \ifx\mk@ids\@empty\else
    \foreach \mk@id in \mk@ids {%
      \edef\mk@annotationtype{%
        \csname midgardkalender@\mk@region @\mk@id @type\endcsname}%
      \ifx\mk@annotationtype\mk@annotationtype@event
        \edef\mk@date{%
          \csname midgardkalender@\mk@region @\mk@id @date\endcsname}%
        \edef\mk@label{%
          \csname midgardkalender@\mk@region @\mk@id @label\endcsname}%
        \ifx\mk@date\@empty\else
          \kalendereintrag[fill=orange!30]{\mk@date}{\dayfont\mk@label}%
        \fi
      \else\ifx\mk@annotationtype\mk@annotationtype@range
        \edef\mk@start{%
          \csname midgardkalender@\mk@region @\mk@id @start\endcsname}%
        \edef\mk@startlabel{%
          \csname midgardkalender@\mk@region @\mk@id @startlabel\endcsname}%
        \edef\mk@end{%
          \csname midgardkalender@\mk@region @\mk@id @end\endcsname}%
        \edef\mk@endlabel{%
          \csname midgardkalender@\mk@region @\mk@id @endlabel\endcsname}%
        \ifx\mk@start\@empty\else
          \zeitspanne[fill=orange!18]
            {\mk@start}{\mk@startlabel}{\mk@end}{\mk@endlabel}%
        \fi
      \else
        \PackageWarning{midgardkalender-v2-3}{%
          Unbekannter Annotationstyp `\mk@annotationtype' fuer
          `\mk@region/\mk@id'}%
      \fi\fi
    }%
  \fi}

