\def\mk@select#1{%
  \@ifundefined{mk@type@#1}{%
    \PackageError{midgardkalender-v2}{Unbekannte Kalenderregion `#1'}{Verfuegbar: default, kanthaipan, alba, waeland, moravod, rawindra, buluga, eschar, nahuatlan.}%
  }{\edef\mk@region{#1}\expandafter\let\expandafter\mk@type\csname mk@type@#1\endcsname}}

\def\mk@getmonthname#1{%
  \def\mk@monthname{Mond}%
  \foreach \mk@n/\mk@name in \mk@months {\ifnum\mk@n=#1\relax\xdef\mk@monthname{\unexpanded\expandafter{\mk@name}}\fi}}

\def\mk@setlayoutdata{%
  \def\mk@family{regular}\def\mk@escharname{eschar}
  \ifx\mk@region\mk@escharname\def\mk@family{eschar}\fi
  \ifx\mk@layout\mk@layout@columns\def\mk@orientation{columns}\else\def\mk@orientation{rows}\fi
  \expandafter\edef\expandafter\mk@placement\expandafter{\csname mk@placement@\mk@family @\mk@orientation\endcsname}
  \expandafter\edef\expandafter\mk@headers\expandafter{\csname mk@headers@\mk@family @\mk@orientation\endcsname}
  \expandafter\edef\expandafter\mk@cols\expandafter{\csname mk@cols@\mk@family @\mk@orientation\endcsname}
  \expandafter\edef\expandafter\mk@rows\expandafter{\csname mk@rows@\mk@family @\mk@orientation\endcsname}}

% --------------------------------------------------------------------------
% Standardrenderer
% --------------------------------------------------------------------------
\def\mk@drawmonth#1#2#3{%
  \mk@getmonthname{#1}%
  \begin{scope}[shift={({\leftgutter+(#2-1)*(\cellwidth+\cellsep)},{\headheight+(#3-1)*(\cellheight+\cellsep)})},xscale=\xstep,yscale=\ystep]
    \draw (0,0) grid (2,15);
    \node[white,fill=black,rectangle,inner sep=\nodeinnersep,text depth=0pt,
      text height={\ystep*1cm-0.5pt-2*\nodeinnersep},align=center,
      text width={\xstep*2cm-0.5pt-2*\nodeinnersep}] at (1,1/2){{\mondfont #1~\mk@monthname}};
    \foreach \mk@d in {1,...,14}{%
      \coordinate (\mk@d-1-#1) at (1/2,\mk@d+1/2);
      \coordinate (\mk@d-2-#1) at (3/2,\mk@d+1/2);}
  \end{scope}}

\def\mk@drawinfo#1#2#3{%
  \begin{scope}[shift={({\leftgutter+(#2-1)*(\cellwidth+\cellsep)},{\headheight+(#3-1)*(\cellheight+\cellsep)})},xscale=\xstep,yscale=\ystep]
    \draw (0,0) grid[xstep=2] (2,15);
    \pgfmathtruncatemacro{\mk@partlabel}{#1}
    \node[fill=black!33,inner sep=\nodeinnersep,text depth=0pt,
      text height={\ystep*1cm-0.5pt-2*\nodeinnersep},text width={\xstep*2cm-0.5pt-2*\nodeinnersep}]
      at (1,1/2){\kalendertagfont\bfseries \mk@partlabel.~Trideade};
    \foreach \mk@d/\mk@dayname in \mk@days {%
      \node[inner sep=\nodeinnersep,text depth=0pt,
        text height={\ystep*1cm-0.5pt-2*\nodeinnersep},text width={\xstep*2cm-0.5pt-2*\nodeinnersep}]
        at (1,1/2+\mk@d){\kalendertagfont\mk@d~\mbox{\mk@dayname}};}
    \foreach \mk@p/\mk@finalname in \mk@finaldays {\ifnum\numexpr\mk@p+1\relax=#1\relax
      \node[inner sep=\nodeinnersep,text depth=0pt,text width={\xstep*2cm-0.5pt-2*\nodeinnersep}]
        at (1,14.5){\kalendertagfont\mk@finalname};\fi}
  \end{scope}}

\def\mk@renderstandard#1{%
  \expandafter\edef\expandafter\mk@months\expandafter{\csname mk@months@\mk@region\endcsname}
  \expandafter\edef\expandafter\mk@days\expandafter{\csname mk@days@\mk@region\endcsname}
  \expandafter\edef\expandafter\mk@finaldays\expandafter{\csname mk@finaldays@\mk@region\endcsname}
  \mk@setlayoutdata
  \pgfmathsetmacro{\nodeinnersep}{2pt}
  \pgfmathsetmacro{\cellsep}{0.08}
  \pgfmathsetmacro{\leftgutter}{0.85}
  \pgfmathsetmacro{\headheight}{0.75}
  \pgfmathsetmacro{\breite}{(\textwidth-3pt)/1cm}
  \pgfmathsetmacro{\hoehe}{(\textheight-6pt)/1cm}
  \pgfmathsetmacro{\cellwidth}{(\breite-\leftgutter-(\mk@cols-1)*\cellsep)/\mk@cols}
  \pgfmathsetmacro{\cellheight}{(\hoehe-\headheight-(\mk@rows-1)*\cellsep)/\mk@rows}
  \pgfmathsetmacro{\xstep}{\cellwidth/2}
  \pgfmathsetmacro{\ystep}{\cellheight/15}
  \noindent\begin{tikzpicture}[yscale=-1,remember picture,line width=0.5pt,
    tag/.style={rectangle,inner sep=\nodeinnersep,text depth=0pt,
      text height={\ystep*1cm-0.5pt-2*\nodeinnersep},text width={\xstep*1cm-0.5pt-2*\nodeinnersep}}]
    \path (0,0) rectangle (\breite,\hoehe);
    \foreach \mk@slot/\mk@label in \mk@headers {%
      \pgfmathsetmacro{\mk@hx}{\leftgutter+(\mk@slot-0.5)*(\cellwidth+\cellsep)-0.5*\cellsep}
      \node at (\mk@hx,0.42*\headheight){\Large\scshape\mk@label};}
    \node[anchor=east] at (\breite-0.15,0.42*\headheight){\Large\bfseries #1};
    % Gemeinsame Tagesnummern je Rasterzeile.
    \foreach \mk@r in {1,...,\mk@rows}{%
      \begin{scope}[shift={(0,{\headheight+(\mk@r-1)*(\cellheight+\cellsep)})},yscale=\ystep]
        \draw (0,0) grid[xstep=\leftgutter] (\leftgutter,15);
        \foreach \mk@d in {1,...,13}{\node[anchor=east,font=\dayfont] at (\leftgutter-0.08,\mk@d+0.5){\mk@d};}
        \node[anchor=east,font=\dayfont] at (\leftgutter-0.08,0.5){\astrosun};
        \node[anchor=east,font=\dayfont] at (\leftgutter-0.08,14.5){M};
      \end{scope}}
    \foreach \mk@kind/\mk@id/\mk@c/\mk@r in \mk@placement {\if M\mk@kind\mk@drawmonth{\mk@id}{\mk@c}{\mk@r}\else\mk@drawinfo{\mk@id}{\mk@c}{\mk@r}\fi}
}

\def\mk@endstandard{%
  \foreach \mk@m in {1,...,13}{%
    \node[tag] at (7-1-\mk@m){\hfill\rightmoon};
    \node[tag] at (7-2-\mk@m){\hfill\leftmoon};
    \node[tag] at (14-1-\mk@m){\hfill\fullmoon};
    \node[tag] at (14-2-\mk@m){\hfill\newmoon};}
  \end{tikzpicture}}

% --------------------------------------------------------------------------
% Darstellung der nahuatlanischen Tagesbezeichnungen
% --------------------------------------------------------------------------
% Der Inhalt eines regulaeren Tagesfeldes wird durch eine frei definierbare
% Schablone festgelegt. Innerhalb dieser Schablone stehen fuer den jeweils
% gerenderten Tag folgende Platzhalter zur Verfuegung:
%   \zahl -- Tageszahl
%   \name -- Tagesname
%   \bild -- Piktogramm aus pics/<Tagesname>.<Endung>
%
% Beispiele:
%   \def\nahuatlandaystyle{\zahl\quad\name}
%   \def\nahuatlandaystyle{\bild}
%   \def\nahuatlandaystyle{\zahl\hfill\bild\hfill\name}
%
% Die Platzhalter werden nur lokal beim Zeichnen eines Tages belegt. Dadurch
% koennen sie in \nahuatlandaystyle beliebig oft und in beliebiger Reihenfolge
% verwendet werden, ohne ausserhalb des Renderers globale Definitionen zu
% ueberschreiben.
\providecommand{\nahuatlandaystyle}{\zahl\quad\name}
\def\mk@nahuatlanpicpath{pics}

% Der Pfad kann bei Bedarf relativ zum Hauptdokument angepasst werden.
\newcommand{\NahuatlanBildpfad}[1]{\gdef\mk@nahuatlanpicpath{#1}}

% Binde ein Piktogramm mit einer der von graphicx ueblicherweise unterstuetzten
% Endungen ein. Fehlt die Datei, bleibt der Kalender kompilierbar und zeigt
% ersatzweise den Tagesnamen an.
\def\mk@nahuatlanpicture#1{%
  \def\mk@nahuatlanpicfile{}%
  \IfFileExists{\mk@nahuatlanpicpath/#1.pdf}%
    {\edef\mk@nahuatlanpicfile{\mk@nahuatlanpicpath/#1.pdf}}{}%
  \ifx\mk@nahuatlanpicfile\@empty
    \IfFileExists{\mk@nahuatlanpicpath/#1.png}%
      {\edef\mk@nahuatlanpicfile{\mk@nahuatlanpicpath/#1.png}}{}%
  \fi
  \ifx\mk@nahuatlanpicfile\@empty
    \IfFileExists{\mk@nahuatlanpicpath/#1.jpg}%
      {\edef\mk@nahuatlanpicfile{\mk@nahuatlanpicpath/#1.jpg}}{}%
  \fi
  \ifx\mk@nahuatlanpicfile\@empty
    \IfFileExists{\mk@nahuatlanpicpath/#1.jpeg}%
      {\edef\mk@nahuatlanpicfile{\mk@nahuatlanpicpath/#1.jpeg}}{}%
  \fi
  \ifx\mk@nahuatlanpicfile\@empty
    \PackageWarning{midgardkalender-v2-5}{Piktogramm fuer `#1' nicht gefunden}%
  \else
    \includegraphics[height=\mk@nahuatlanpicheight]{\mk@nahuatlanpicfile}%
  \fi}

% Belege die drei oeffentlichen Platzhalter fuer genau einen Tag und werte
% anschliessend die benutzerdefinierte Schablone aus.
\def\mk@nahuatlandaycontent#1#2{%
  \begingroup
    \def\zahl{#1}%
    \def\name{#2}%
    \def\bild{\mk@nahuatlanpicture{#2}}%
    \nahuatlandaystyle
  \endgroup}

% --------------------------------------------------------------------------
% Nahuatlanrenderer
% --------------------------------------------------------------------------
\def\mk@rendernahuatlan#1{%
  \pgfmathsetmacro{\nodeinnersep}{1.7pt}
  \pgfmathsetmacro{\breite}{(\textwidth-3pt)/1cm}
  \pgfmathsetmacro{\hoehe}{(\textheight-6pt)/1cm}
  \pgfmathsetmacro{\kopf}{0.75}
  \pgfmathsetmacro{\sep}{0.08}
  \ifx\mk@layout\mk@layout@columns
    \def\mk@qcols{6}\def\mk@qrows{3}%
  \else
    \def\mk@qcols{3}\def\mk@qrows{6}%
  \fi
  \pgfmathsetmacro{\qwidth}{(\breite-(\mk@qcols-1)*\sep)/\mk@qcols}
  \pgfmathsetmacro{\qheight}{(\hoehe-\kopf-(\mk@qrows-1)*\sep)/\mk@qrows}
  \pgfmathsetmacro{\ystep}{\qheight/22}
  \pgfmathsetlengthmacro{\mk@nahuatlanpicheight}{0.72*\ystep cm}
  \noindent\begin{tikzpicture}[yscale=-1,remember picture,line width=0.5pt,
    tag/.style={rectangle,inner sep=\nodeinnersep,text depth=0pt,
      text height={\ystep*1cm-0.5pt-2*\nodeinnersep},text width={\qwidth*1cm-0.5pt-2*\nodeinnersep}}]
    \path (0,0) rectangle (\breite,\hoehe);
    \node[anchor=west] at (0.15,0.42*\kopf){\Large\scshape Nahuahauquihtl};
    \node[anchor=east] at (\breite-0.15,0.42*\kopf){\Large\bfseries #1};
    \foreach \mk@q in {1,...,18}{%
      \pgfmathtruncatemacro{\mk@c}{mod(\mk@q-1,\mk@qcols)}
      \pgfmathtruncatemacro{\mk@r}{floor((\mk@q-1)/\mk@qcols)}
      \begin{scope}[shift={({\mk@c*(\qwidth+\sep)},{\kopf+\mk@r*(\qheight+\sep)})},xscale=\qwidth,yscale=\ystep]
        \def\mk@qgridrows{21}%
        \ifnum\mk@q=2\relax
        \def\mk@qgridrows{22}%
        \fi
        \ifnum\mk@q=8\relax
        \def\mk@qgridrows{22}%
        \fi
        \ifnum\mk@q=15\relax
        \def\mk@qgridrows{22}%
        \fi
        \ifnum\mk@q=18\relax
        \def\mk@qgridrows{22}%
        \fi
        \draw (0,0) grid (1,\mk@qgridrows);
        \node[white,fill=black,rectangle,inner sep=\nodeinnersep,text depth=0pt, text height={\ystep*1cm-0.5pt-2*\nodeinnersep}, 
          text width={\qwidth*1cm-0.5pt-2*\nodeinnersep},align=center] at (1/2,1/2){\scalebox{0.75}{\mondfont\mk@q.~Quiautl}};
        \foreach \mk@d/\mk@dayname in \mk@nahuatlandays {%
          \coordinate (\mk@d-\mk@q) at (1/2,\mk@d+1/2);
          \node[font=\dayfont,align=left,text width={\qwidth*1cm-4pt}] at (1/2,\mk@d+1/2)%
               {\mk@nahuatlandaycontent{\mk@d}{\mk@dayname}};
          \pgfmathtruncatemacro{\mk@dayindex}{(\mk@q-1)*20+\mk@d+(\mk@q>2)+(\mk@q>8)+(\mk@q>15)}%
          \mk@nahuatlanphase{\mk@dayindex}{\mk@d+1/2}%
        }
        \ifnum\mk@q=2 \mk@hollow{2}{41}\fi
        \ifnum\mk@q=8 \mk@hollow{8}{162}\fi
        \ifnum\mk@q=15 \mk@hollow{15}{303}\fi
        \ifnum\mk@q=18 \mk@hollow{18}{364}\fi
      \end{scope}}
}
% Mondphase zum fortlaufenden Tag des nahuatlanischen Jahres.
% Da Tag 364 ein Neumondtag ist, gilt fuer den Rest modulo 28:
% 0 = Neumond, 7 = zunehmender Halbmond, 14 = Vollmond,
% 21 = abnehmender Halbmond.
\def\mk@nahuatlanphase#1#2{%
  \pgfmathtruncatemacro{\mk@phasemod}{mod(#1,28)}%
  \def\mk@phasesymbol{}%
  \ifnum\mk@phasemod=0\relax\def\mk@phasesymbol{\newmoon}\fi
  \ifnum\mk@phasemod=7\relax\def\mk@phasesymbol{\rightmoon}\fi
  \ifnum\mk@phasemod=14\relax\def\mk@phasesymbol{\fullmoon}\fi
  \ifnum\mk@phasemod=21\relax\def\mk@phasesymbol{\leftmoon}\fi
  \ifx\mk@phasesymbol\@empty\else
    \node[anchor=east,inner sep=1.5pt,font=\dayfont] at (0.98,#2){\mk@phasesymbol};%
  \fi}

% Ein Hohler Tag belegt exakt eine Rasterzeile und damit dieselbe Hoehe
% wie jeder regulaere Kalendertag, unabhaengig von Seitenformat und -groesse.
\def\mk@hollow#1#2{%
  \coordinate (hollow-after-#1) at (1/2,21.5);%
  \node[tag,fill=black!20,font=\dayfont,align=left]
    at (1/2,21.5){\mk@nahuatlandaycontent{}{Hohler Tag}};%
  \mk@nahuatlanphase{#2}{21.5}%
}
\def\mk@endnahuatlan{\end{tikzpicture}}

% --------------------------------------------------------------------------
% Umgebung
% --------------------------------------------------------------------------
\NewDocumentEnvironment{midgardkalender}{m O{Jahr}}{%
  \begingroup\mk@select{#1}\let\showholidays\mk@showholidays
  \ifx\mk@type\mk@type@standard\mk@renderstandard{#2}\else\mk@rendernahuatlan{#2}\fi
}{%
  \ifx\mk@type\mk@type@standard\mk@endstandard\else\mk@endnahuatlan\fi
  \endgroup}

\makeatother
\endinput
